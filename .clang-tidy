Checks: '-*,bugprone-*,performance-*,modernize-*,readability-*,clang-analyzer-*,-modernize-use-trailing-return-type'
WarningsAsErrors: '*'
HeaderFilterRegex: 'include/togyz/.*'
AnalyzeTemporaryDtors: false
FormatOnLint: true
CheckOptions:
  - key:             readability-identifier-naming.ClassCase
    value:           CamelCase
  - key:             readability-identifier-naming.StructCase
    value:           CamelCase
  - key:             readability-identifier-naming.FunctionCase
    value:           lower_case
  - key:             readability-identifier-naming.VariableCase
    value:           lower_case
