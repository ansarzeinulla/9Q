{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/web/public/wasm/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    { 
      "source": "/togyzkumalak-pgn", 
      "destination": "/web/togyzkumalak-pgn.html" 
    },
    {
        "source": "/",
        "destination": "/web/index.html"
    }
  ]
}