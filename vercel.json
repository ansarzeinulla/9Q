{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/wasm/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/game.html" },
    { "source": "/game", "destination": "/game.html" },
    { "source": "/analysis", "destination": "/analysis.html" },
    { "source": "/togyzkumalak-pgn", "destination": "/analysis.html" }
  ]
}